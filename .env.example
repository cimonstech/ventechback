# Copy this file to .env and replace placeholder values with your real keys

PORT=5000

SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

JWT_SECRET=your_jwt_secret

FRONTEND_URL=https://localhost:3000

RESEND_API_KEY=your_resend_api_key
RESEND_SUPPORT_EMAIL="VENTECH GADGETS <support@ventechgadgets.com>"
RESEND_NOREPLY_EMAIL="VENTECH GADGETS <noreply@ventechgadgets.com>"

# Paystack keys for backend payout transfers and payment initialization
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
